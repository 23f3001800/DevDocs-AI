# ── LLM Providers (set at least one) ─────────────────────────
# Fallback order: Anthropic → Gemini → Grok
# Only providers with a valid API key are activated.
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-api-key-here
XAI_API_KEY=xai-your-grok-key-here

# Model overrides (optional — sensible defaults are used)
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-3-mini-fast

# ── Embeddings + Vector Store ────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db

# ── API Security ─────────────────────────────────────────────
API_KEY=dev-secret-key-change-in-prod
JWT_SECRET=change-this-to-a-random-secret-in-production

# ── Evaluation (RAGAS uses Gemini as evaluator LLM) ──────────
# Uses the same GOOGLE_API_KEY from above

# ── Observability (optional — tracing activates only if set) ─
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=devdocs-ai