# ── LLM Provider (Gemini) ────────────────────────────────────
# Gemini is the only supported provider. Without a key the app falls back to a
# MockProvider for offline/CI work — and refuses to start when APP_ENV=production,
# so a typo here fails loudly instead of silently serving mock answers.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024

# ── Embeddings + Vector Store ────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=devdocs
EMBED_CACHE_MAX=512

# ── Retrieval knobs ──────────────────────────────────────────
# Sweep these against `python -m scripts.run_evals` rather than guessing —
# chunk size is the single highest-leverage RAG hyperparameter.
RETRIEVAL_INITIAL_K=20
RRF_K=60
CHUNK_SIZE_CODE=1200
CHUNK_OVERLAP_CODE=100
CHUNK_SIZE_TEXT=600
CHUNK_OVERLAP_TEXT=60

# ── Runtime environment ──────────────────────────────────────
# Set APP_ENV=production on deployed instances. Production refuses to start
# unless JWT_SECRET (>=32 chars), ADMIN_PASSWORD and GOOGLE_API_KEY are all set.
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated CORS origins. Defaults to "*" (dev). Pin in production,
# e.g. ALLOWED_ORIGINS=https://devdocs.example.com
ALLOWED_ORIGINS=*

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (required when APP_ENV=production)
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRY_HOURS=24
# Seed password for the auto-created 'admin' account (required in production)
ADMIN_PASSWORD=change-me

# ── User database ────────────────────────────────────────────
# NOTE: on a PaaS with an ephemeral filesystem this must point at a mounted
# volume, or every redeploy wipes the user table.
DB_PATH=./data/devdocs.db

# ── Rate limiting ────────────────────────────────────────────
ASK_RATE_LIMIT=30/minute
INGEST_RATE_LIMIT=5/minute
# "memory://" is per-process. With >1 uvicorn worker or replica the effective
# limit is multiplied by the process count — point this at Redis to share it,
# e.g. RATE_LIMIT_STORAGE_URI=redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://
# Only enable behind a proxy you control. X-Forwarded-For is client-spoofable,
# so trusting it on a directly-exposed server lets anyone dodge rate limits.
TRUST_PROXY_HEADERS=false

# ── Ingestion ────────────────────────────────────────────────
INGEST_TIMEOUT_SECONDS=10

# ── Evaluation ───────────────────────────────────────────────
# RAGAS judge model. Deliberately different (and stronger) than GEMINI_MODEL:
# a model scoring its own output shows self-preference bias.
RAGAS_EVALUATOR_MODEL=gemini-2.5-pro

# ── Observability (optional — tracing activates only if set) ─
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=devdocs-ai
